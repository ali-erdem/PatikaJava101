import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        
        System.out.print("Sayı Giriniz :");
        int sayi = input.nextInt();
        
        double sonuc = 0.0; 

        for(double i = 1; i <=sayi; i++){
            sonuc += (1/i);
        }
        System.out.println("Sonuç:" +sonuc);
    }
}
