public class Fighter {
    String name;
    int damage;
    int health;
    int weight;
    double dodge;

    public Fighter(String name, int damage,int health, int weight, double dodge){
        this.name = name;
        this.damage = damage;
        this.health = health;
        this.weight = weight;
        this.dodge = dodge;
    }
    public int hit(Fighter  fe){
        System.out.println("------------");
        System.out.println(this.name + " => " + fe.name + " " +  this.damage + " hasar vurdu.");

        if(fe.dodge()){
            System.out.println(fe.name + " gelen hasarı savurdu.");
            return fe.health;
        }
        if (fe.health - this.damage < 0)
            return 0;
        return fe.health - this.damage;

    }

    public boolean dodge(){
        double randomValue = Math.random() * 100;
        return randomValue <= this.dodge;
    }

}

