import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        System.out.print("Dizi için eleman sayısını giriniz: ");
        int sayi = scanner.nextInt();

        int[] dizi = new int[sayi];

        // 1. Adım: Elemanları kullanıcıdan alıyoruz
        for(int i = 0; i < dizi.length; i++) {
            System.out.print("Dizi için eleman girin: ");
            dizi[i] = scanner.nextInt();
        }

        for(int i = 0; i < dizi.length - 1; i++) {
            for(int j = 0; j < dizi.length - 1 - i; j++) {
                if(dizi[j] > dizi[j + 1]) {
                    int gecici = dizi[j]; 
                    dizi[j] = dizi[j + 1];
                    dizi[j + 1] = gecici;
                }
            }
        }
        System.out.println("\n--- Dizinin Küçükten Büyüğe Sıralanmış Hali ---");
        for(int i = 0; i < dizi.length; i++) {
            System.out.println((i + 1) + ". eleman: " + dizi[i]);
        }
    }
}
