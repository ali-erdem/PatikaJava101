import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int sayi;

        System.out.print("Bir sayı giriniz: ");
        sayi = scanner.nextInt();

        for(int i = 1; i <= sayi; i++){
            System.out.println();
           for(int j = (sayi - i + 1); j > 0; j--){
            System.out.print("*");
            }   
        }
    }
}
