import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        int sayi;
        int toplam = 0;
        Scanner scanner = new Scanner(System.in);
        
        do{
            System.out.print("Bir sayı giriniz: ");
            sayi = scanner.nextInt();
            if((sayi %2 == 0) && (sayi %4 == 0) ){
                toplam +=  sayi;
            }
        }while(sayi %2 == 0);
    System.out.print("Toplam: " +toplam);
    }
}
