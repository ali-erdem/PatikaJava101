public class Employee {
    String name;
    int salary;
    int workHours;
    int hireYears;

    public Employee(String name, int salary, int workHours, int hireYears) {
        this.name = name;
        this.salary = salary;
        this.workHours = workHours;
        this.hireYears = hireYears;
    }

    public double tax(Employee e) {
        double newSalary = 0;
        double newTax = 0;

        if (this.salary < 1000) {
            return 0;
        } else if (this.salary > 1000) {
            newTax = (this.salary * 0.03);
            newSalary = this.salary - (this.salary * 0.03);
            return newTax;
        }
        return newSalary;
    }

    public int bonus(Employee e) {
        int calisma;
        int yenicalisma =0;
        if(this.workHours > 40 ){
            calisma = this.workHours -40;
            yenicalisma = calisma * 30;
        }
        return yenicalisma;
    }

    public int raiseSalary(Employee e) {
        int yeni_yil = 2021 - this.hireYears;
        double zamMiktari = 0;
        if(yeni_yil<10){
            zamMiktari = this.salary * 0.05;
        }
        else if(yeni_yil >9 && yeni_yil <20){
            zamMiktari = this.salary * 0.10;
        }
        else if(yeni_yil > 19){
            zamMiktari = this.salary * 0.15;
        }
        return (int) zamMiktari;
    }
    public String toString(){
        double vergi = this.tax(this);
        int bonusMiktari = this.bonus(this);
        int zamMiktari = this.raiseSalary(this);
        double toplamMaas = this.salary - vergi + bonusMiktari + zamMiktari;
        return "Adı: " + this.name +
                "\nMaaşı: " + this.salary +
                "\nVergi: " + vergi +
                "\nBonus: " + bonusMiktari +
                "\nMaaş Artışı: " + zamMiktari +
                "\nVergi ve Bonuslar ile Birlikte Maaş: " + (this.salary - vergi + bonusMiktari) +
                "\nToplam Maaş: " + toplamMaas;
    }
}
